{% include "@components/header-prototypes/header-oisp.twig" %}

<section class="hero bleed img-fill full">
	<img src="../../images/oisp/oisp-home-hero.jpg" alt="pipette and test tubes">
	<div class="grid-container">
		<div class="grid-x grid-margin-x">
            <div class="cell large-5 small-12">
                <div class="callout">
                    <h1 class="h2">Advancing Research Innovation from Discovery to Impact</h1>
                    <p>The Office of Innovation & Strategic Partnerships supports faculty and researchers in advancing discovery, commercialization, and strategic partnerships—helping innovations move toward...</p>
                    <p><a href="#" class="button">Explore our opportunities</a></p>
                </div>
            </div>
        </div>
	</div>
</section>

{% include "@components/navigation-prototypes/navbar-oisp.twig" %}

<section class="bleed margin-top margin-bottom">
    <div class="grid-container">
        <div class="grid-x grid-margin-x">
            <div class="card tile cell small-12 medium-6 large-4">
            <img src="../../images/oisp/predisclosure-tile.jpg">
            <div class="card-section">
                <div>
                    <h3 class="h4">Submit a Pre-Disclosure</h3>
                    <p>Have an idea or early research discovery? Start by submitting a brief pre-disclosure form to help OISP understand your innovation and guide you through the next steps in the disclosure process.</p>
                    <p><a class="button">Learn More</a></p>
                </div>
            </div>
        </div>
            <div class="card tile cell small-12 medium-6 large-4">
            <img src="../../images/oisp/market-tile.jpg">
            <div class="card-section">
                <div>
                    <h3 class="h4">Our Market-First Approach</h3>
                    <p>OISP uses a market-first approach to help faculty evaluate potential applications, assess market opportunity, and prioritize next steps—before investing time and resources.</p>
                    <p><a class="button">Learn More</a></p>
                </div>
            </div>
        </div>
            <div class="card tile cell small-12 medium-6 large-4">
            <img src="../../images/oisp/partnership-tile.jpg">
            <div class="card-section">
                <div>
                    <h3 class="h4">Industry & Partnership Engagement</h3>
                    <p>OISP works with industry, startups, and external partners to advance university innovations, support collaboration, and help move technologies toward real-world use.</p>
                    <p><a class="button">Learn More</a></p>
                </div>
            </div>
        </div>
        </div>
    </div>
</section>

<section class="bleed beige">
<div class="grid-container">
    <div class="grid-x grid-margin-x align-middle align-spaced">
        <div class="small-12 medium-8 cell">
            <h3>Office of Innovation & Strategic Partnerships Newsletter</h3>
            <p>Sign-up to receive OISP newsletters.</p>
            <form>
                <label>Email Address
                    <input type="text" class="small-4">
                </label>
                <button type="submit" class="button">Subscribe</button>
        </div>
        <div class="small-12 medium-2 large-4 cell">
        <a class="callout color blue flex-child-auto">
                <span class="fa-stack fa-2x">
                    <i class="fas fa-circle fa-stack-2x"></i>
                    <i class="fas fa-inbox fa-stack-1x fa-inverse"></i>
                </span>
                <h3>View Newsletters</h3>
            </a>
        </div>
    </div>
  </div>
</section>

{% include "@components/footer-prototypes/oisp-footer.twig" %}
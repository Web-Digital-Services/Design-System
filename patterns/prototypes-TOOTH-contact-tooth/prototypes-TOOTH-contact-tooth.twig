{% include "@components/header-prototypes/header-tooth.twig" %}
<section class="hero bleed">
    <div class="grid-container">
        <div class="grid-x grid-margin-x">
            <div class="small-12 medium-8 large-8 cell">
                <h1>Contact Us</h1>
                <p>The Tooth Project is recruiting 150 elementary school teachers from across South Texas to participate in the study. If you are interested in learning more about the study or how to participate, please complete the form below.</p>
                
            </div>
        </div>
    </div>
</section>

{% include "@components/navigation-prototypes/navbar-tooth.twig" %}

<section class="grid-container">
    <div class="grid-x grid-margin-x">
        <div class="cell large-8 medium-8 small-12">
            <form>
				<label>Full name
					<input type="text">
				</label>
				<label>Your email address
					<input type="text">
				</label>
                <legend><label>Are you currently an elementary school teacher?</label></legend>
					<input type="radio" id="elementaryyes" name="elementaryyes" value="elementaryyes">
                    <label for="elementaryyes">Yes</label><br>
                    <input type="radio" id="elementaryno" name="elementaryno" value="elementaryno">
                    <label for="elementaryno">No</label><br>
                <label>Which grade are you currently teaching?
					<input type="text">
				</label>
                <legend><label>Are your students between 5 and 10 years old?</label></legend>
					<input type="radio" id="ageyes" name="ageyes" value="ageyes">
                    <label for="ageyes">Yes</label><br>
                    <input type="radio" id="ageno" name="ageno" value="ageno">
                    <label for="ageno">No</label><br>
                <label>How many students are you currently teaching?
					<input type="text">
				</label>
                 <label>Name of the school where you are currently teaching:
					<input type="text">
				</label>
                 <label>Address of the school where you are currently teaching:
					<input type="text">
				</label>
                
				<!--<label>Subject
					<input type="text">
				</label>-->
                <label>
                Message
                <textarea rows="5"></textarea>
                </label>
                <p><a class="button">Submit</a></p>
            </form>
        </div>
        <div class="cell large-4 medium-4 small-12">
            <!--<p><strong>The Tooth Project</strong><br>School of Dentisry<br>7703 Floyd Curl Drive<br>San Antonio, TX 78229<br><a href="http://www.uthscsa.edu/university/maps-and-directions">Maps & Directions</a></p>
            <p>Phone: <a>210-000-4900</a><br>Email: <a>kajimoton@uthscsa.edu</a></p>-->
</p>
            <a class="callout color orange flex-child-auto">
                <span class="fa-stack fa-2x">
                    <i class="fas fa-circle fa-stack-2x"></i>
                    <i class="fas fa-list fa-stack-1x fa-inverse"></i>
                </span>
                <h3>FAQ</h3>
            </a>
            <a class="callout color blue flex-child-auto">
                <span class="fa-stack fa-2x">
                    <i class="fas fa-circle fa-stack-2x"></i>
                    <i class="fas fa-laptop fa-stack-1x fa-inverse"></i>
                </span>
                <h3>Training</h3>
            </a>
            
        </div>
        

    </div>
</section>





